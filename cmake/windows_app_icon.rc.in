#include <winver.h>
101 ICON "@APP_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @APP_FILE_VERSION@
PRODUCTVERSION @APP_FILE_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Tonho Studios\0"
      VALUE "FileDescription", "@APP_PRODUCT_NAME@\0"
      VALUE "FileVersion", "@APP_VERSION_STRING@\0"
      VALUE "InternalName", "@APP_INTERNAL_ID@\0"
      VALUE "OriginalFilename", "@APP_EXECUTABLE_NAME@\0"
      VALUE "ProductName", "Creative Suite\0"
      VALUE "ProductVersion", "@APP_VERSION_STRING@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
