if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
set(fixture "${CMAKE_CURRENT_BINARY_DIR}/timeout-fixture")
file(MAKE_DIRECTORY "${fixture}/cmake")
configure_file("${SOURCE_ROOT}/cmake/run_test_with_temp_dir.cmake" "${fixture}/cmake/run_test_with_temp_dir.cmake" COPYONLY)
file(WRITE "${fixture}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(TimeoutFixture NONE)\nenable_testing()\ninclude(\"${SOURCE_ROOT}/cmake/AddIsolatedTest.cmake\")\nadd_creative_suite_test(NAME default COMMAND \"${CMAKE_COMMAND}\" -E echo default)\nif(DEFINED PROBE_TIMEOUT)\nadd_creative_suite_test(NAME custom TIMEOUT \"\${PROBE_TIMEOUT}\" COMMAND \"${CMAKE_COMMAND}\" -E echo custom)\nendif()\n")
foreach(value IN ITEMS 300 0 invalid)
    set(binary "${fixture}/build-${value}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${binary}" "-DPROBE_TIMEOUT=${value}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(value STREQUAL "300")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid timeout rejected: ${output}${error}")
        endif()
        file(READ "${binary}/CTestTestfile.cmake" commands)
        if(NOT commands MATCHES "TEST_TIMEOUT_SECONDS=120" OR NOT commands MATCHES "TEST_TIMEOUT_SECONDS=300")
            message(FATAL_ERROR "Default/custom wrapper timeouts were lost")
        endif()
        find_program(ctest NAMES ctest REQUIRED)
        execute_process(COMMAND "${ctest}" --test-dir "${binary}" -C Release --output-on-failure RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Configured isolated wrappers failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "TIMEOUT must be a positive integer")
        message(FATAL_ERROR "Invalid timeout was not rejected: ${value}")
    endif()
endforeach()
