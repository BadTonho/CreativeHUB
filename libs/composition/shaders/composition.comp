#version 450
#ifdef PRECISE_ROTATION
#extension GL_ARB_gpu_shader_fp64 : require
#define REAL double
#define REAL2 dvec2
#define REAL4 dvec4
#else
#define REAL float
#define REAL2 vec2
#define REAL4 vec4
#endif
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,rgba8ui) uniform readonly uimage2D background_image;
layout(binding=1,rgba8ui) uniform readonly uimage2D foreground_image;
layout(binding=2,rgba8ui) uniform readonly uimage2D mask_image;
layout(binding=3,rgba8ui) uniform writeonly uimage2D output_image;
layout(binding=4,rgba8) uniform image2D presentation_image;
layout(binding=5,std430) readonly buffer AdjustmentValues { vec4 adjustment_values[]; };
layout(push_constant) uniform Parameters {
    ivec4 control; // operation, blur radius, horizontal, stage
    REAL2 center; REAL2 extent;
    REAL2 trig; REAL2 scale_opacity;
    vec4 color;
} p;
float sampleCurve(int index, int curve, float input_value) {
    int x = int(floor(clamp(input_value, 0.0, 1.0) * 255.0 + 0.5));
    int base = index * 586 + 7 + curve * 64 + x / 4;
    vec4 packed = adjustment_values[base];
    int component = x - (x / 4) * 4;
    float value = component == 0 ? packed.x : component == 1 ? packed.y :
        component == 2 ? packed.z : packed.w;
    return floor(value * 255.0 + 0.5) / 255.0;
}
float curveOffset(int index, int curve, float input_value) {
    return (sampleCurve(index, curve, input_value) * 255.0 - 128.0) / 127.0;
}
float rangeWeight(float value, float minimum, float maximum, float softness) {
    float lower = softness <= 0.0 ? float(value >= minimum) :
        smoothstep(minimum - softness, minimum + softness, value);
    float upper = softness <= 0.0 ? float(value <= maximum) :
        1.0 - smoothstep(maximum - softness, maximum + softness, value);
    return min(lower, upper);
}
struct Hsv { float h; float s; float v; };
Hsv toHsv(vec3 rgb) {
    float maximum = max(max(rgb.r, rgb.g), rgb.b);
    float minimum = min(min(rgb.r, rgb.g), rgb.b);
    float delta = maximum - minimum;
    Hsv result; result.h = 0.0; result.s = maximum <= 0.0 ? 0.0 : delta / maximum;
    result.v = maximum;
    if (delta <= 0.0) return result;
    if (maximum == rgb.r) result.h = 60.0 * mod((rgb.g - rgb.b) / delta, 6.0);
    else if (maximum == rgb.g) result.h = 60.0 * ((rgb.b - rgb.r) / delta + 2.0);
    else result.h = 60.0 * ((rgb.r - rgb.g) / delta + 4.0);
    if (result.h < 0.0) result.h += 360.0;
    return result;
}
vec3 fromHsv(Hsv hsv) {
    hsv.h = mod(hsv.h, 360.0); if (hsv.h < 0.0) hsv.h += 360.0;
    hsv.s = clamp(hsv.s, 0.0, 1.0); hsv.v = clamp(hsv.v, 0.0, 1.0);
    float chroma = hsv.v * hsv.s;
    float x = chroma * (1.0 - abs(mod(hsv.h / 60.0, 2.0) - 1.0));
    float m = hsv.v - chroma;
    if (hsv.h < 60.0) return vec3(chroma + m, x + m, m);
    if (hsv.h < 120.0) return vec3(x + m, chroma + m, m);
    if (hsv.h < 180.0) return vec3(m, chroma + m, x + m);
    if (hsv.h < 240.0) return vec3(m, x + m, chroma + m);
    if (hsv.h < 300.0) return vec3(x + m, m, chroma + m);
    return vec3(chroma + m, m, x + m);
}
float qualifierMatte(vec3 rgb, int index) {
    int base = index * 586;
    vec4 range = adjustment_values[base + 583];
    vec4 softness = adjustment_values[base + 584];
    vec4 flags = adjustment_values[base + 585];
    if (flags.y < 0.5) return 1.0;
    Hsv hsv = toHsv(rgb);
    float hue = hsv.h;
    float end = range.y;
    float hue_sample = hue;
    if (!(range.x == 0.0 && range.y == 360.0) && end < range.x) {
        end += 360.0;
        if (hue_sample < range.x) hue_sample += 360.0;
    }
    float hue_weight = range.x == 0.0 && range.y == 360.0 ? 1.0 :
        rangeWeight(hue_sample, range.x, end, softness.z);
    float sat_weight = rangeWeight(hsv.s * 100.0, range.z, range.w, softness.w);
    precise float luma = clamp(rgb.r * 0.2126 + rgb.g * 0.7152 + rgb.b * 0.0722,
        0.0, 1.0) * 100.0;
    float luma_weight = rangeWeight(luma, softness.x, softness.y, flags.x);
    return hue_weight * sat_weight * luma_weight;
}
vec3 applyVideoCurves(vec3 source_rgb, int index) {
    int base = index * 586;
    precise float luminance = clamp(source_rgb.r * 0.2126 + source_rgb.g * 0.7152 +
        source_rgb.b * 0.0722, 0.0, 1.0);
    float mapped = sampleCurve(index, 0, luminance);
    vec3 rgb = luminance > 1e-12 ? clamp(source_rgb * (mapped / luminance), 0.0, 1.0) : vec3(mapped);
    rgb = vec3(sampleCurve(index, 1, rgb.r), sampleCurve(index, 2, rgb.g),
        sampleCurve(index, 3, rgb.b));
    precise float old_luma = clamp(rgb.r * 0.2126 + rgb.g * 0.7152 +
        rgb.b * 0.0722, 0.0, 1.0);
    Hsv hsv = toHsv(rgb);
    float hue_offset = curveOffset(index, 4, hsv.h / 360.0);
    hsv.h += hue_offset * (360.0 / 255.0);
    hsv.s += curveOffset(index, 5, hsv.h / 360.0);
    float luma_delta = curveOffset(index, 6, hsv.h / 360.0);
    hsv.s += curveOffset(index, 7, old_luma);
    hsv.s += curveOffset(index, 8, hsv.s);
    vec3 adjusted = fromHsv(hsv);
    float target_luma = clamp(old_luma + luma_delta, 0.0, 1.0);
    if (luma_delta != 0.0) {
        precise float adjusted_luma = adjusted.r * 0.2126 + adjusted.g * 0.7152 +
            adjusted.b * 0.0722;
        if (adjusted_luma > 1e-12) adjusted = clamp(adjusted * (target_luma / adjusted_luma), 0.0, 1.0);
    }
    float matte = qualifierMatte(source_rgb, index);
    return floor(clamp(mix(source_rgb, adjusted, matte), 0.0, 1.0) * 255.0 + 0.5) / 255.0;
}
vec3 adjustColor(vec3 rgb, int index) {
    int base = index * 586;
    if (adjustment_values[base + 585].z > 0.5)
        return applyVideoCurves(rgb, index);
    vec4 affine = adjustment_values[base];
    vec4 lift_saturation = adjustment_values[base + 1];
    vec4 gamma_gain_red = adjustment_values[base + 2];
    vec4 gain_green_blue = adjustment_values[base + 3];
    rgb = rgb * affine.x + affine.yzw;
    float shadow_luma = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    float shadow_amount = clamp(1.0 - shadow_luma, 0.0, 1.0);
    float shadow_weight = shadow_amount * shadow_amount;
    rgb += lift_saturation.rgb * shadow_weight;
    if (gamma_gain_red.x != 1.0) rgb.r = pow(max(rgb.r, 0.0), gamma_gain_red.x);
    if (gamma_gain_red.y != 1.0) rgb.g = pow(max(rgb.g, 0.0), gamma_gain_red.y);
    if (gamma_gain_red.z != 1.0) rgb.b = pow(max(rgb.b, 0.0), gamma_gain_red.z);
    float luma = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
    rgb = (vec3(luma) + (rgb - vec3(luma)) * lift_saturation.w) *
        vec3(gamma_gain_red.w, gain_green_blue.xy);
    float log_luma = clamp(dot(rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
    float shadows = 1.0 - smoothstep(0.20, 0.45, log_luma);
    float highlights = smoothstep(0.55, 0.80, log_luma);
    float midtones = clamp(1.0 - shadows - highlights, 0.0, 1.0);
    rgb += adjustment_values[base + 4].rgb * shadows +
        adjustment_values[base + 5].rgb * midtones +
        adjustment_values[base + 6].rgb * highlights;
    return floor(clamp(rgb, 0.0, 1.0) * 255.0 + 0.5) / 255.0;
}
uvec4 source(ivec2 pos) { return imageLoad(background_image,pos); }
uvec4 over(uvec4 bg,uvec4 fg) {
    uint a=fg.a*255u+bg.a*(255u-fg.a);
    uvec3 n=fg.rgb*fg.a*255u+bg.rgb*bg.a*(255u-fg.a);
    return uvec4(a==0u?uvec3(0):(n+uvec3(a/2u))/a,(a+127u)/255u);
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(output_image);
    if(any(greaterThanEqual(pixel,size)))return;
    int op=p.control.x;
    uvec4 c=uvec4(0);
    if(op==10) { imageStore(output_image,pixel,uvec4(floor(clamp(imageLoad(presentation_image,pixel),0,1)*255.0+0.5)));return; }
    if(op==8) { imageStore(output_image,pixel,uvec4(0,0,0,255));return; }
    if(op==1 || op==7) {
        ivec2 srcsize=op==7?imageSize(foreground_image):imageSize(background_image);
        precise REAL2 delta=REAL2(pixel)+REAL(0.5)-p.center;
        precise REAL2 local=REAL2(p.trig.x*delta.x+p.trig.y*delta.y,
            -p.trig.y*delta.x+p.trig.x*delta.y);
        precise REAL2 mapped=(local/p.extent+REAL(0.5))*REAL2(srcsize);
        ivec2 samplepos=ivec2(floor(mapped));
        bool inside=all(lessThanEqual(abs(local),p.extent*REAL(0.5)));
        if(op==7) {
            c=source(pixel);
            if(inside) {
                uvec4 f=imageLoad(foreground_image,clamp(samplepos,ivec2(0),srcsize-1));
                vec4 bg=vec4(c)/255.0, fg=vec4(f)/255.0;
                float a=fg.a*float(p.scale_opacity.y);
                c=uvec4(floor(clamp(vec4(fg.rgb*a+bg.rgb*(1-a),a+bg.a*(1-a)),0,1)*255.0+0.5));
            }
        } else if(all(greaterThanEqual(samplepos,ivec2(0))) && all(lessThan(samplepos,srcsize))) {
            c=source(samplepos); c.a=uint(floor(REAL(c.a)*p.scale_opacity.y+REAL(0.5)));
        }
    } else if(op==11) {
        ivec2 srcsize=imageSize(foreground_image);
        precise REAL2 delta=REAL2(pixel)+REAL(0.5)-p.center;
        precise REAL2 local=REAL2(p.trig.x*delta.x+p.trig.y*delta.y,
            -p.trig.y*delta.x+p.trig.x*delta.y);
        precise REAL2 mapped=local/REAL(p.scale_opacity.x)+REAL2(srcsize)*REAL(0.5);
        ivec2 samplepos=ivec2(floor(mapped));
        uvec3 adjusted=uvec3(0);
        if(all(greaterThanEqual(samplepos,ivec2(0))) && all(lessThan(samplepos,srcsize))) {
            adjusted=imageLoad(foreground_image,samplepos).rgb;
            vec3 rgb=vec3(adjusted)/255.0;
            for(int i=0;i<p.control.y;++i) {
                rgb=adjustColor(rgb,i);
                rgb=floor(clamp(rgb,0.0,1.0)*255.0+0.5)/255.0;
            }
            adjusted=uvec3(floor(rgb*255.0+0.5));
        }
        uvec3 original=imageLoad(background_image,pixel).rgb;
        vec3 mixed=vec3(original)*(1.0-float(p.scale_opacity.y))+
            vec3(adjusted)*float(p.scale_opacity.y);
        c=uvec4(uvec3(floor(mixed+0.5)),255u);
    } else {
        c=source(pixel);
        if(op==2) {
            vec3 rgb=vec3(c.rgb)/255.0;
            for(int i=0;i<p.control.y;++i) {
                rgb=adjustColor(rgb,i);
                rgb=floor(clamp(rgb,0.0,1.0)*255.0+0.5)/255.0;
            }
            c.rgb=uvec3(floor(rgb*255.0+0.5));
        } else if(op==3) {
            ivec2 fs=imageSize(foreground_image);
            REAL scale=min(REAL(size.x)/REAL(fs.x),REAL(size.y)/REAL(fs.y));
            ivec2 fitted=max(ivec2(1),ivec2(floor(REAL2(fs)*scale+REAL(0.5))));
            ivec2 local=pixel-(size-fitted)/2;
            if(all(greaterThanEqual(local,ivec2(0))) && all(lessThan(local,fitted)))
                c=over(c,imageLoad(foreground_image,clamp(ivec2(REAL2(local)/scale),ivec2(0),fs-1)));
        } else if(op==4) c.a=(c.a*imageLoad(mask_image,pixel).r+127u)/255u;
        else if(op==5) {
            uint coverage=imageLoad(mask_image,pixel).r;
            uvec4 fg=imageLoad(foreground_image,pixel);
            if(coverage==255u)c=fg;
            else if(coverage!=0u) {
                uint ba=c.a*(255u-coverage),fa=fg.a*coverage,a=ba+fa;
                c=uvec4(a==0u?uvec3(0):(c.rgb*ba+fg.rgb*fa+uvec3(a/2u))/a,(a+127u)/255u);
            }
        } else if(op==6) {
            if(p.control.w==0)c.rgb=(c.rgb*c.a+uvec3(127))/255u;
            else if(p.control.w==7)c.rgb=c.a==0u?uvec3(0):min(uvec3(255),(c.rgb*255u+uvec3(c.a/2u))/c.a);
            else {
                uvec4 sum=uvec4(0);ivec2 step=p.control.z!=0?ivec2(1,0):ivec2(0,1);
                for(int i=-p.control.y;i<=p.control.y;++i)sum+=source(clamp(pixel+step*i,ivec2(0),size-1));
                uint divisor=uint(p.control.y*2+1);c=(sum+uvec4(divisor/2u))/divisor;
            }
        } else if(op==9) {
            vec4 display=vec4(c)/255.0;
            if(p.control.w!=0)display.rgb=vec3(dot(display.rgb,vec3(0.2126,0.7152,0.0722)));
            imageStore(presentation_image,pixel,display);
        }
    }
    imageStore(output_image,pixel,c);
}
